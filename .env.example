NODE_ENV=development
PORT=3000

# Client Portal URLs
CLIENT_URL=http://localhost:3000
ADMIN_CLIENT_URL=http://localhost:3001

# Database Configuration (MySQL)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USERNAME=root
# DB_PASSWORD=your_password
# DB_NAME=app_db

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER_NAME=root
DB_PASSWORD=Password@123
DATABASE_NAME=slice

# Initial Admin Seeding Configuration
ADMIN_EMAIL=slice.admin@yopmail.com
ADMIN_PASSWORD=Admin@123

# JWT Authentication Configuration
JWT_SECRET=slice_backend_jwt_super_secret_key_2026
JWT_EXPIRES_IN=1d
JWT_RESET_PASSWORD_EXPIRES_IN=1h

# SMTP Email Configuration (Leave empty to log reset links to console in development)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=no-reply@slice.com
