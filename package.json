{
  "name": "express-typeorm-mysql",
  "version": "1.0.0",
  "description": "Express + TypeORM + MySQL backend starter with health check",
  "main": "dist/server.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typeorm": "typeorm-ts-node-commonjs -d src/config/data-source.ts",
    "seed:admin": "ts-node-dev --transpile-only src/seed/run-seed.ts",
    "migration:generate": "npm run typeorm -- migration:generate src/migrations/Migration",
    "migration:run": "npm run typeorm -- migration:run",
    "migration:revert": "npm run typeorm -- migration:revert"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.0.0",
    "joi": "^18.3.1",
    "jsonwebtoken": "^9.0.3",
    "mysql2": "^3.11.5",
    "nodemailer": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.10.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/nodemailer": "^8.0.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.2"
  }
}
